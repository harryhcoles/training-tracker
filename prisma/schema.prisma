generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserState {
  id                Int        @id @default(1)
  currentMesoNum    Int        @default(1)
  currentWeek       Int        @default(1)
  programmeStart    DateTime   @default(now())
  cycleStartedAt    DateTime?
  squatTarget       Int        @default(120)
  benchTarget       Int        @default(75)
  deadliftTarget    Int        @default(120)
  activeProgrammeId String?
  activeProgramme   Programme? @relation(fields: [activeProgrammeId], references: [id])
  updatedAt         DateTime   @updatedAt
}

model Programme {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String?
  totalWeeks    Int              @default(12)
  cycleLength   Int              @default(7)
  deloadWeeks   Int[]            @default([4, 8, 12])
  isCustom      Boolean          @default(false)
  scheduleSlots ProgrammeSlot[]
  templates     SessionTemplate[]
  activeIn      UserState[]
  createdAt     DateTime         @default(now())
}

model ProgrammeSlot {
  id          Int       @id @default(autoincrement())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  categoryId  String

  @@unique([programmeId, dayOfWeek, categoryId])
}

model ScheduleSlot {
  id         Int    @id @default(autoincrement())
  dayOfWeek  Int
  categoryId String

  @@unique([dayOfWeek, categoryId])
}

// Per-week overrides. If any rows exist for a given (mesoNum, weekNum)
// they are the canonical schedule for that week — defaults are
// ignored for that week. Use absence of rows for a week to mean
// "no override applied; fall back to ScheduleSlot defaults".
model WeekScheduleSlot {
  id         Int    @id @default(autoincrement())
  mesoNum    Int
  weekNum    Int
  dayOfWeek  Int
  categoryId String

  @@unique([mesoNum, weekNum, dayOfWeek, categoryId])
  @@index([mesoNum, weekNum])
}

model SessionTemplate {
  id          String             @id @default(cuid())
  category    String
  phase       String
  name        String
  description String?
  durationMin Int?
  focus       String?
  isCustom    Boolean            @default(false)
  programmeId String?
  programme   Programme?         @relation(fields: [programmeId], references: [id])
  weekNum     Int?
  dayOfWeek   Int?
  exercises   ExerciseTemplate[]
  logs        SessionLog[]
  createdAt   DateTime           @default(now())
}

model ExerciseTemplate {
  id                Int             @id @default(autoincrement())
  sessionTemplateId String
  template          SessionTemplate @relation(fields: [sessionTemplateId], references: [id], onDelete: Cascade)
  orderIndex        Int
  name              String
  sets              Int
  reps              Int?
  durationSec       Int?
  perSide           Boolean         @default(false)
  note              String?
}

model SessionLog {
  id                String          @id @default(cuid())
  sessionTemplateId String
  template          SessionTemplate @relation(fields: [sessionTemplateId], references: [id])
  mesoNum           Int
  weekNum           Int
  loggedAt          DateTime        @default(now())
  sessionRpe        Int?
  notes             String?
  durationActualMin Float?
  distanceKm        Float?
  avgHr             Int?
  avgPower          Int?
  avgSpeedKmh       Float?
  hrAtGoalPace      Int?
  timeInGoalPaceSec Int?
  stravaActivityId  BigInt?         @unique
  stravaStartDate   DateTime?
  sets              ExerciseSet[]
}

model WeightEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  weightKg  Float
  notes     String?
  createdAt DateTime @default(now())
}

model ExerciseSet {
  id           Int        @id @default(autoincrement())
  sessionLogId String
  log          SessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  exerciseName String
  setNumber    Int
  weightKg     Float?
  reps         Int?
  durationSec  Int?
  rpe          Int?
}
